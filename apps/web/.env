# Server-side secrets for loaders, actions, and /api/* resource routes.
# Loaded by Node (`--env-file-if-exists=.env`) before the server starts, so
# read them with `process.env.NAME` inside the handler.
#
# Never give a secret a VITE_ prefix — those are inlined into the browser bundle.

# Google Maps / Places API key. Leave empty to run in fallback mode (airport-code
# matching only; live address autocomplete and distance/fare estimates are
# disabled until a key is supplied). Get one at:
#   https://console.cloud.google.com/google/maps-apis
# Enable the Places API and Distance Matrix API, then paste the key here and
# reload the app. The dashboard's "Mapping" card shows the current status.
GOOGLE_MAPS_API_KEY=AIzaSyBVnrBbRTUN014_Nml7mqgoYipOCAG8jyI

# Square card-payment credentials. Leave empty to run in request-only mode
# (reservations are submitted without charging a card). When all three are
# set, the booking flow shows Square's secure in-page card form at the end
# of checkout and charges the exact server-calculated fare. The card details
# are tokenized by Square's iframe and never touch this site; only the token
# is sent to the server, which creates the payment with the access token.
# Get these from the Square Developer Dashboard → your application.
#   SQUARE_APP_ID              — application ID (PUBLIC; safe for the browser
#                                Web Payments SDK). Production: sq0idb-...
#                                Sandbox: sandbox-sq0idb-...
#   SQUARE_ACCESS_TOKEN        — application access token (SECRET; server only)
#   SQUARE_LOCATION_ID         — the location to charge payments against
#   SQUARE_WEBHOOK_SIGNATURE_KEY — webhook signature key (optional; webhook only)
#   SQUARE_ENVIRONMENT          — 'production' (default) or 'sandbox'
SQUARE_APP_ID=sq0idp-2ug5YDXVyVEAvvfTdhmK7Q
SQUARE_ACCESS_TOKEN=EAAAl2sNt69aisvaRELVnmZZ_z3dCzcuVhm7lsf_1fThZleP1q04kaX7riZf3l3v
SQUARE_LOCATION_ID=LZC9GJCJBSRFJ
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_ENVIRONMENT=production

# HERE Traffic Flow API key (optional). Leave empty to run without live traffic
#   on the reservation map (the route still shows; traffic overlay is hidden).
# Get one at https://platform.here.com → Freemium → Traffic API.
# When set, the booking map colors the driving route by live congestion
#   (free flow / slow / heavy) with a legend. Server-side only.
HERE_TRAFFIC_API_KEY=
